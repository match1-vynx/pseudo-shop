# Handles user signup and login


# ----------------------------
# Feature 2: User login & Registration
# ----------------------------


# ----------------------------
# In-memory user storage
# ----------------------------
user_list = []

# Stores the currently logged-in user
current_user = null


# ----------------------------
# validation helper functions
# ----------------------------

# Check if a value is empty
function is_blank(value):
    if value is null:
        return true

    if trim(value) == "":
        return true

    return false


# Normalize email before saving or checking
function normalize_email(email):
    return lowercase(trim(email))


# Check if a name is valid
function is_valid_name(name):
    if is_blank(name):
        return false

    trimmed_name = trim(name)

    if length(trimmed_name) < 2:
        return false

    return true


# Check if text contains a space
function has_spaces(value):
    if " " in value:
        return true

    return false


# Count how many times a character appears in a value
function count_character(value, character):
    total_count = 0

    for each current_character in value:
        if current_character == character:
            total_count = total_count + 1

    return total_count


# Check if email has a stronger valid format
function is_valid_email(email):
    if is_blank(email):
        return false

    normalized_email = normalize_email(email)

    if has_spaces(normalized_email):
        return false

    if count_character(normalized_email, "@") != 1:
        return false

    email_parts = split normalized_email by "@"
    local_part = email_parts[0]
    domain_part = email_parts[1]

    if is_blank(local_part):
        return false

    if is_blank(domain_part):
        return false

    if "." not in domain_part:
        return false

    if domain_part starts with ".":
        return false

    if domain_part ends with ".":
        return false

    return true


# Check if password has at least one uppercase letter
function has_uppercase_letter(value):
    for each character in value:
        if character is uppercase letter:
            return true

    return false


# Check if password has at least one lowercase letter
function has_lowercase_letter(value):
    for each character in value:
        if character is lowercase letter:
            return true

    return false


# Check if password has at least one number
function has_number(value):
    for each character in value:
        if character is number:
            return true

    return false


# Check if password follows stronger security rules
function is_valid_password(password):
    if is_blank(password):
        return false

    if length(password) < 8:
        return false

    if has_uppercase_letter(password) == false:
        return false

    if has_lowercase_letter(password) == false:
        return false

    if has_number(password) == false:
        return false

    return true


# ----------------------------
# create_user & helper funcs
# ----------------------------

# Find an existing user by email
function find_user_by_email(email):
    normalized_email = normalize_email(email)

    for each user in user_list:
        if user.email == normalized_email:
            return user

    return null


# Create a new user account
function create_user(name, email, password):
    if is_valid_name(name) == false:
        print "Registration failed: name must have at least 2 characters"
        return false

    if is_valid_email(email) == false:
        print "Registration failed: valid email is required"
        return false

    if is_valid_password(password) == false:
        print "Registration failed: password must be at least 8 characters and include uppercase, lowercase, and number"
        return false

    normalized_email = normalize_email(email)
    existing_user = find_user_by_email(normalized_email)

    if existing_user is not null:
        print "Registration failed: email already exists"
        return false

    new_user = {
        "id": length(user_list) + 1,
        "name": trim(name),
        "email": normalized_email,
        "password": password
    }

    append new_user to user_list

    print "Registration successful for " + new_user.name
    return true




# ----------------------------
# login function
# ----------------------------

# Log in using email and password
function login_user(email, password):
    if is_valid_email(email) == false:
        print "Login failed: valid email is required"
        return false

    if is_blank(password):
        print "Login failed: password is required"
        return false

    normalized_email = normalize_email(email)
    found_user = find_user_by_email(normalized_email)

    if found_user is null:
        print "Login failed: account does not exist"
        return false

    if found_user.password != password:
        print "Login failed: incorrect password"
        return false

    current_user = found_user

    print "Login successful. Welcome, " + current_user.name
    return true



# ----------------------------
# logout function
# ----------------------------

# Log out the currently logged-in user
function logout_user():
    if current_user is null:
        print "Logout failed: no user is currently logged in"
        return false

    print current_user.name + " has logged out"
    current_user = null
    return true


# Check if there is a logged-in user
function is_logged_in():
    if current_user is null:
        return false

    return true


# Display the current login status
function display_current_user():
    if current_user is null:
        print "No user is currently logged in"
    else:
        print "Logged in as " + current_user.name + " using " + current_user.email

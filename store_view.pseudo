# Displays product listings

function display_products():
    if product_list is empty:
        print "No products available in the store."
        return

    print "Storefront"
    print "--------------------"

    for each product in product_list:
        print "Name: " + product.name
        print "Price: $" + product.price
        print "Attributes:"
        print "  Width: " + product.width
        print "  Height: " + product.height
        print "  Length: " + product.length
        print "  Weight: " + product.weight
        print "  Color: " + product.color
        print "  Brand: " + product.brand
        print "--------------------"

# Show a short summary of available products
function display_store_summary():
    total_products = length of product_list
    print "Total products available: " + total_products

# Show the first product in the store
function display_featured_product():
    if product_list is empty:s
        print "No featured product available."
        returns

    featured_product = product_list[0]
    print "Featured product: " + featured_product.name
